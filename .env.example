# Clé API Albert. Uniquement côté serveur : ne jamais exposer au navigateur.
ALBERT_API_KEY=

# Point d'entrée de l'API Albert.
ALBERT_BASE_URL=https://albert.api.etalab.gouv.fr

# Modèle de chat utilisé pour la génération.
ALBERT_CHAT_MODEL=gpt-oss-120b

# Identifiants des collections à interroger, séparés par des virgules.
# Cette liste remplace les deux variables historiques ci-dessous lorsqu'elle
# est définie. Elle doit contenir au moins un identifiant positif.
# ALBERT_COLLECTION_IDS=10,11

# Compatibilité avec le démonstrateur ANSSI : utilisées uniquement si
# ALBERT_COLLECTION_IDS n'est pas définie.
ALBERT_COLLECTION_FR=
ALBERT_COLLECTION_EN=

# Origines des pages autorisées à afficher le widget dans une iframe,
# séparées par des virgules. Vide : seule la page `/` du service peut
# l'afficher. Lu au build : redéployer après modification.
# EMBED_ALLOWED_PARENTS=https://intranet.example.gouv.fr
# Direct Web Component callers, comma-separated bare origins (no wildcard).
# API policy, read at runtime. Restart the service after changing.
WIDGET_ALLOWED_ORIGINS=
